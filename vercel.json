{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/server",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "dist/server/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
