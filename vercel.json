{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/server",
  "framework": "tanstack-start",
  "regions": ["iad1"],
  "routes": [
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}